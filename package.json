{
  "name": "seqora-platform",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter @seqora/contracts build && pnpm --filter @seqora/prompting build",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @seqora/web dev",
    "dev:admin": "pnpm --filter @seqora/admin dev",
    "dev:db": "docker compose -f compose.local.yml --profile dev up -d postgres-dev redis-dev",
    "dev:db:down": "docker compose -f compose.local.yml --profile dev down",
    "dev:test-db": "docker compose -f compose.local.yml --profile test up -d postgres-test redis-test",
    "dev:test-db:down": "docker compose -f compose.local.yml --profile test down -v",
    "dev:api": "pnpm dev:db && pnpm build:shared && pnpm --filter @seqora/api dev",
    "dev:worker": "pnpm dev:db && pnpm build:shared && pnpm --filter @seqora/api dev:worker",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm build:shared && pnpm -r test",
    "regression:novel:biancheng": "pnpm --filter @seqora/api regression:novel:biancheng",
    "regression:novel:biancheng:live": "pnpm --filter @seqora/api regression:novel:biancheng:live",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "3.9.5"
  }
}
