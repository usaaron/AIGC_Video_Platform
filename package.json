{
  "name": "seqora-platform",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter @seqora/contracts build && pnpm --filter @seqora/prompting build",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @seqora/web dev",
    "dev:admin": "pnpm --filter @seqora/admin dev",
    "dev:db": "docker compose -f compose.local.yml --profile dev up -d postgres-dev redis-dev",
    "dev:db:down": "docker compose -f compose.local.yml --profile dev down",
    "dev:test-db": "docker compose -f compose.local.yml --profile test up -d postgres-test redis-test",
    "dev:test-db:down": "docker compose -f compose.local.yml --profile test down -v",
    "dev:api": "pnpm dev:db && pnpm build:shared && pnpm --filter @seqora/api dev",
    "dev:worker": "pnpm dev:db && pnpm build:shared && pnpm --filter @seqora/api dev:worker",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "check:organization-api": "node scripts/check-deprecated-organization-routes.mjs",
    "test": "pnpm build:shared && pnpm -r test",
    "test:backend:unit": "pnpm build:shared && pnpm --filter @seqora/api test:unit",
    "test:backend:coverage": "pnpm build:shared && pnpm --filter @seqora/api test:unit:coverage && pnpm --filter @seqora/api coverage:check",
    "test:backend:integration": "pnpm build:shared && pnpm --filter @seqora/api test:integration",
    "test:backend:contract": "pnpm --filter @seqora/contracts test && pnpm build:shared && pnpm --filter @seqora/api test:api-contract",
    "test:backend:legacy": "pnpm build:shared && pnpm --filter @seqora/api test:legacy",
    "test:backend:security": "pnpm build:shared && pnpm --filter @seqora/api test:security",
    "test:backend:pyramid": "pnpm test:backend:unit && pnpm test:backend:contract && pnpm test:backend:integration",
    "test:backend:full": "pnpm test:backend:pyramid && pnpm test:backend:legacy && pnpm test:backend:security",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:dependency-check": "node scripts/security/dependency-check.mjs",
    "security:sonar": "node scripts/security/sonar-scan.mjs",
    "perf:k6:smoke": "node scripts/perf/run-k6.mjs smoke",
    "perf:k6:breakpoint": "node scripts/perf/run-k6.mjs breakpoint",
    "probe:synthetic": "node scripts/monitoring/synthetic-probe.mjs",
    "probe:synthetic:write": "node scripts/monitoring/synthetic-probe.mjs --mode write",
    "probe:synthetic:all": "node scripts/monitoring/synthetic-probe.mjs --mode all",
    "regression:novel:biancheng": "pnpm --filter @seqora/api regression:novel:biancheng",
    "regression:novel:biancheng:live": "pnpm --filter @seqora/api regression:novel:biancheng:live",
    "preprod:anonymize:check": "pnpm --filter @seqora/api db:anonymize-preprod:check",
    "preprod:anonymize": "pnpm --filter @seqora/api db:anonymize-preprod",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "3.9.5"
  }
}
