{
  "name": "@seqora/api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "test": "vitest run",
    "worker": "tsx src/worker.ts",
    "regression:novel:biancheng": "tsx src/scripts/novelBianchengRegression.ts",
    "regression:novel:biancheng:live": "tsx src/scripts/novelBianchengRegression.ts --live"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@google-cloud/storage": "7.21.0",
    "@seqora/contracts": "workspace:*",
    "@seqora/prompting": "workspace:*",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "pg": "8.13.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.0",
    "oxlint": "1.74.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
