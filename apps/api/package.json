{
  "name": "@seqora/api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "db:migrate": "tsx src/scripts/dbMigrate.ts",
    "accounts:init": "tsx src/scripts/initProductionAccounts.ts",
    "accounts:reset-admin-password": "tsx src/scripts/resetBootstrapAdminPassword.ts",
    "db:repair-personal-organizations": "tsx src/scripts/repairPersonalOrganizations.ts",
    "db:anonymize-preprod": "tsx src/scripts/anonymizePreprodData.ts",
    "db:anonymize-preprod:check": "tsx src/scripts/anonymizePreprodData.ts --dry-run",
    "db:import-json": "tsx src/scripts/importJsonToPostgres.ts",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "coverage:check": "tsx src/scripts/checkCoverage.ts",
    "test": "vitest run --maxWorkers=1",
    "test:legacy": "vitest run src/app.test.ts",
    "test:api-contract": "vitest run src/contracts/httpContract.test.ts",
    "test:security": "vitest run src/security/httpSecurity.test.ts",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage --coverage.reporter=json-summary --coverage.reporter=text-summary",
    "test:integration": "vitest run --project integration",
    "worker": "tsx src/worker.ts",
    "regression:novel:biancheng": "tsx src/scripts/novelBianchengRegression.ts",
    "regression:novel:biancheng:live": "tsx src/scripts/novelBianchengRegression.ts --live"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@google-cloud/storage": "7.21.0",
    "@seqora/contracts": "workspace:*",
    "@seqora/prompting": "workspace:*",
    "bullmq": "^5.81.3",
    "dotenv": "17.4.2",
    "fastify": "5.11.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.11.1",
    "jsonrepair": "3.15.0",
    "pg": "8.13.1",
    "stripe": "^22.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.0",
    "ajv": "^8.20.0",
    "oxlint": "1.74.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
