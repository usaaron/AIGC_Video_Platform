{
  "name": "@seqora/api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "files": [
    "dist",
    ".env.example"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:import-json": "tsx src/scripts/importJson.ts",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.0",
    "@google-cloud/storage": "7.21.0",
    "@seqora/contracts": "workspace:*",
    "ali-oss": "6.23.0",
    "bullmq": "5.80.9",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "pg": "8.13.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/node": "26.1.1",
    "@types/pg": "8.11.10",
    "oxlint": "1.74.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
