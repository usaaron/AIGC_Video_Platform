NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://localhost:5173
# Public HTTPS origin of this API. Required only for automatic AIGC portrait registration.
PUBLIC_API_BASE_URL=
TRUST_PROXY=false
RATE_LIMIT_MAX=300

AUTH_MODE=local
AUTH_SECRET=replace-with-at-least-32-random-characters
# Used only when DATA_FILE does not exist yet. Production values must be unique.
BOOTSTRAP_CREATOR_NAME=林夏
BOOTSTRAP_CREATOR_EMAIL=creator@seqora.local
BOOTSTRAP_CREATOR_PASSWORD=replace-with-a-unique-creator-password
BOOTSTRAP_ADMIN_NAME=平台管理员
BOOTSTRAP_ADMIN_EMAIL=admin@seqora.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
# Development sample only. Production defaults to false when omitted.
BOOTSTRAP_DEMO_WORKSPACE=true
DATA_FILE=./data/app.json

# Use local for zero-config development. Set gcs for the hosted demo.
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
GCS_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Active Seedance video provider. StringX is the default and shares the MaaS tenant.
VIDEO_PROVIDER=stringx
STRINGX_BASE_URL=https://maas.stringx.top/api/v3
STRINGX_API_KEY=
STRINGX_VIDEO_MODEL=doubao-seedance-2-0-260128
STRINGX_REQUEST_TIMEOUT_MS=120000

# Independent third-party fallback. It cannot read StringX maas-* portrait assets.
AIDEOS_BASE_URL=https://aideos.openrouter.icu
AIDEOS_API_KEY=
AIDEOS_VIDEO_MODEL=doubao-seedance-2-0-260128
AIDEOS_REQUEST_TIMEOUT_MS=120000
VIDEO_POLL_INTERVAL_MS=5000

# Optional official Volcengine rollback route. Used only when VIDEO_PROVIDER=volc-ark.
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
ARK_REQUEST_TIMEOUT_MS=120000

# StringX MaaS Assets OpenAPI uses AK/SK SigV4, not an Aideos bearer token.
# These credentials and STRINGX_API_KEY must belong to the same StringX tenant/project.
VOLC_ASSET_BASE_URL=https://maas-ark.stringx.top
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_ARK_PROJECT_NAME=default
ASSET_LIBRARY_CONSOLE_URL=
VOLC_ASSET_REQUEST_TIMEOUT_MS=30000

# Local FFmpeg extracts Aideos tail frames and merges completed shots into one preview MP4.
FFMPEG_PATH=ffmpeg
FILM_PREVIEW_TIMEOUT_MS=600000

# TokenAdvent text and image generation.
TOKENADVENT_BASE_URL=https://tokenadvent.com
TOKENADVENT_API_KEY=
IMG2_MODEL=gpt-image-2
IMG2_QUALITY=low
TEXT_MODEL=gpt-5.6
TOKENADVENT_REQUEST_TIMEOUT_MS=180000
