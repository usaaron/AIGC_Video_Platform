NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
# Public API origin used to create short-lived signed media URLs for remote providers.
API_PUBLIC_BASE_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173

AUTH_MODE=local
AUTH_SECRET=replace-with-at-least-32-random-characters
# Keep auto in real deployments. Set false only for local HTTP deployment acceptance.
SESSION_COOKIE_SECURE=auto
DATA_STORE=json
DATA_FILE=./data/app.json
# DATABASE_URL=postgres://seqora:seqora@127.0.0.1:5432/seqora

# API processes only create and enqueue tasks. Worker processes consume BullMQ.
TASK_QUEUE_DRIVER=bullmq
REDIS_URL=redis://127.0.0.1:6379
TASK_WORKER_CONCURRENCY=4
TASK_QUEUE_TICK_INTERVAL_MS=1000

# Use local only for zero-config development. Production must use gcs or oss.
# Use mock only for deployment acceptance with ALLOW_MOCK_STORAGE=true.
STORAGE_DRIVER=local
ALLOW_MOCK_STORAGE=false
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
GENERATED_ASSET_MAX_BYTES=104857600

# Google Cloud Storage. Use ADC or GOOGLE_APPLICATION_CREDENTIALS for credentials.
GCS_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Aliyun OSS. Keep access keys in apps/api/.env or your deployment secret manager.
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_INTERNAL=false
OSS_SECURE=true

# Aideos Seedance 2.0. Keep the API key in apps/api/.env or your deployment secret manager.
SEEDANCE_API_BASE_URL=https://aideos.openrouter.icu
SEEDANCE_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0-260128
SEEDANCE_POLL_INTERVAL_MS=5000
SEEDANCE_REQUEST_TIMEOUT_MS=30000

# Aideos Img2 image provider. IMG2_API_KEY can stay empty to reuse SEEDANCE_API_KEY.
IMG2_API_BASE_URL=https://aideos.openrouter.icu
IMG2_API_KEY=
IMG2_MODEL=img2-default
IMG2_REQUEST_TIMEOUT_MS=30000

# Aideos audio provider. AUDIO_API_KEY can stay empty to reuse SEEDANCE_API_KEY.
AUDIO_API_BASE_URL=https://aideos.openrouter.icu
AUDIO_API_KEY=
AUDIO_MODEL=audio-default
AUDIO_REQUEST_TIMEOUT_MS=30000

# Film export uses ffmpeg in API Worker when provider=film-export.
FILM_EXPORT_FFMPEG_PATH=ffmpeg
FILM_EXPORT_TIMEOUT_MS=300000
