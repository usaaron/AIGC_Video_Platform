NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://localhost:5173
# Public HTTPS origin of this API. Required only for automatic AIGC portrait registration.
PUBLIC_API_BASE_URL=
TRUST_PROXY=false
RATE_LIMIT_MAX=300

# Task queue. Use bullmq for dev/prod; tests can use inline or none.
TASK_QUEUE_DRIVER=bullmq
TASK_QUEUE_NAME=seqora-generation
TASK_QUEUE_WORKER_CONCURRENCY=2
TASK_QUEUE_POLL_INTERVAL_MS=5000
REDIS_URL=redis://127.0.0.1:6379

AUTH_MODE=local
AUTH_SECRET=replace-with-at-least-32-random-characters
BILLING_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Local development can use console to print delivery metadata without sending mail.
# Production requires resend, a verified sender domain, and a real API key.
EMAIL_PROVIDER=console
EMAIL_FROM="Seqora <no-reply@seqora.local>"
EMAIL_REPLY_TO=
RESEND_API_KEY=
EMAIL_REQUEST_TIMEOUT_MS=15000
EMAIL_MAX_RETRIES=2
EMAIL_RETRY_BASE_DELAY_MS=250
BILLING_ALERT_EMAILS=
AUTH_PASSWORD_RESET_URL=http://localhost:5173/reset-password
AUTH_EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
AUTH_INVITATION_URL=http://localhost:5173/register
# Payment provider. Use Stripe test mode keys for local sandbox verification.
PAYMENT_PROVIDER=none
BILLING_SUCCESS_URL=http://localhost:5173/billing/success
BILLING_CANCEL_URL=http://localhost:5173/billing/cancelled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MEMBER_PRICE_ID=
STRIPE_CREDIT_PRICE_ID=
STRIPE_CREDIT_PACK_CREDITS=100
DATABASE_URL=
# Development/test can bootstrap local demo accounts on startup.
# Production must keep this false and run accounts:init explicitly after db:migrate.
BOOTSTRAP_ACCOUNTS_ON_START=true
BOOTSTRAP_MEMBER_NAME=默认 C 端用户
BOOTSTRAP_MEMBER_EMAIL=member@seqora.local
BOOTSTRAP_MEMBER_PASSWORD=replace-with-a-unique-member-password
BOOTSTRAP_OWNER_NAME=平台所有者
BOOTSTRAP_OWNER_EMAIL=owner@seqora.local
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-unique-owner-password
BOOTSTRAP_SUPER_ADMIN_NAME=超级管理员
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@seqora.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-a-unique-super-admin-password
BOOTSTRAP_ADMIN_NAME=平台管理员
BOOTSTRAP_ADMIN_EMAIL=admin@seqora.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
# Development sample only. Production forbids this and always starts without demo seed data.
BOOTSTRAP_DEMO_WORKSPACE=true
DATA_FILE=./data/app.json

# Use local for zero-config development. Set gcs for the hosted demo.
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
GCS_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Active Seedance video provider. StringX is the default and shares the MaaS tenant.
VIDEO_PROVIDER=stringx
STRINGX_BASE_URL=https://maas.stringx.top/api/v3
STRINGX_API_KEY=
STRINGX_VIDEO_MODEL=doubao-seedance-2-0-260128
STRINGX_SEEDANCE_DEFAULT_TIER=fast
STRINGX_SEEDANCE_MINI_MODEL=doubao-seedance-2-0-260128
STRINGX_SEEDANCE_FAST_MODEL=doubao-seedance-2-0-260128
STRINGX_SEEDANCE_PRO_MODEL=doubao-seedance-2-0-260128
STRINGX_REQUEST_TIMEOUT_MS=120000

VIDEO_POLL_INTERVAL_MS=5000

# Optional official Volcengine rollback route. Used only when VIDEO_PROVIDER=volc-ark.
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
ARK_REQUEST_TIMEOUT_MS=120000

# StringX MaaS Assets OpenAPI uses AK/SK SigV4, not the Seedance bearer token.
# These credentials and STRINGX_API_KEY must belong to the same StringX tenant/project.
VOLC_ASSET_BASE_URL=https://maas-ark.stringx.top
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_ARK_PROJECT_NAME=default
ASSET_LIBRARY_CONSOLE_URL=
VOLC_ASSET_REQUEST_TIMEOUT_MS=30000

# Local FFmpeg merges completed shots into one preview MP4.
FFMPEG_PATH=ffmpeg
FILM_PREVIEW_TIMEOUT_MS=600000

# DeepSeek text generation. Kept as a selectable StringX-compatible Chat Completions option.
DEEPSEEK_BASE_URL=https://maas.stringx.top
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseekV3
DEEPSEEK_CHAT_COMPLETIONS_PATH=/api/v1/chat/completions
DEEPSEEK_REQUEST_TIMEOUT_MS=180000

# Rehdasu text generation. GLM/Kimi models use an OpenAI-compatible Chat Completions endpoint.
REHDASU_BASE_URL=https://tokenadvent.com
REHDASU_API_KEY=
REHDASU_MODEL=glm-5.2
REHDASU_CHAT_COMPLETIONS_PATH=/v1/chat/completions
REHDASU_REQUEST_TIMEOUT_MS=180000

# Seqora image2 generation. Legacy TOKENADVENT_* keys remain as a temporary fallback.
SEQORA_IMAGE2_BASE_URL=https://tokenadvent.com
SEQORA_IMAGE2_API_KEY=
SEQORA_IMAGE2_MODEL=gpt-image-2
SEQORA_IMAGE2_ASSIST_MODEL=gpt-5.4
SEQORA_IMAGE2_ASSIST_TIMEOUT_MS=60000

# TokenAdvent-compatible selectable SEQORA text generation and legacy image2 fallback.
TOKENADVENT_BASE_URL=https://tokenadvent.com
TOKENADVENT_API_KEY=
IMG2_MODEL=gpt-image-2
IMG2_QUALITY=low
TEXT_MODEL=glm-5.2
TOKENADVENT_REQUEST_TIMEOUT_MS=180000
