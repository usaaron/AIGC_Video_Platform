# Public domain. Point its A/AAAA record to the VM before starting Caddy.
APP_ADDRESS=xumutv.com
WEB_ORIGIN=https://xumutv.com
PUBLIC_API_BASE_URL=https://xumutv.com

TRUST_PROXY=true
RATE_LIMIT_MAX=300
AUTH_MODE=local
AUTH_SECRET=replace-with-at-least-32-random-characters
BILLING_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
EMAIL_PROVIDER=resend
EMAIL_FROM="序幕TV <no-reply@xumutv.com>"
EMAIL_REPLY_TO=
RESEND_API_KEY=
EMAIL_REQUEST_TIMEOUT_MS=15000
EMAIL_MAX_RETRIES=2
EMAIL_RETRY_BASE_DELAY_MS=250
BILLING_ALERT_EMAILS=
AUTH_PASSWORD_RESET_URL=https://xumutv.com/reset-password
AUTH_EMAIL_VERIFICATION_URL=https://xumutv.com/verify-email
AUTH_INVITATION_URL=https://xumutv.com/register
PAYMENT_PROVIDER=none
BILLING_SUCCESS_URL=https://xumutv.com/billing/success
BILLING_CANCEL_URL=https://xumutv.com/billing/cancelled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MEMBER_PRICE_ID=
STRIPE_CREDIT_PRICE_ID=
STRIPE_CREDIT_PACK_CREDITS=100

# Postgres-backed auth accounts and sessions.
POSTGRES_DB=seqora_prod
POSTGRES_USER=seqora
POSTGRES_PASSWORD=replace-with-unique-postgres-password
DATABASE_URL=postgres://seqora:replace-with-unique-postgres-password@postgres:5432/seqora_prod
# Per-process pool guardrails. API and worker each have their own pool.
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=0
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# BullMQ-backed generation task queue. compose.demo.yml provides the redis service.
TASK_QUEUE_DRIVER=bullmq
TASK_QUEUE_NAME=seqora-generation
TASK_QUEUE_WORKER_CONCURRENCY=2
TASK_QUEUE_POLL_INTERVAL_MS=5000
REDIS_URL=redis://redis:6379

# Used only by the explicit account initialization command:
# docker compose --env-file deploy/demo.env -f compose.demo.yml run --rm api node dist/scripts/initProductionAccounts.js
# API and worker startup must never bootstrap accounts in production.
BOOTSTRAP_ACCOUNTS_ON_START=false
BOOTSTRAP_MEMBER_NAME=默认 C 端用户
BOOTSTRAP_MEMBER_EMAIL=member@example.com
BOOTSTRAP_MEMBER_PASSWORD=replace-with-a-unique-member-password
BOOTSTRAP_OWNER_NAME=平台所有者
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-unique-owner-password
BOOTSTRAP_SUPER_ADMIN_NAME=超级管理员
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-a-unique-super-admin-password
BOOTSTRAP_ADMIN_NAME=平台管理员
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
BOOTSTRAP_DEMO_WORKSPACE=false

# Runtime limits for a 2 vCPU / 4 GB closed-beta VM.
API_CPUS=1.5
API_MEMORY_LIMIT=1536m
API_NODE_HEAP_MB=768
WORKER_CPUS=1.5
WORKER_MEMORY_LIMIT=1536m
WORKER_NODE_HEAP_MB=768
WEB_CPUS=0.5
WEB_MEMORY_LIMIT=192m

# Google Cloud Storage. Attach a least-privilege service account to the VM.
STORAGE_DRIVER=gcs
GCS_BUCKET=replace-with-private-gcs-bucket
MAX_UPLOAD_BYTES=10485760

# StringX Seedance 2.0. Keep video and asset credentials in the same StringX tenant/project.
VIDEO_PROVIDER=stringx
STRINGX_BASE_URL=https://maas.stringx.top/api/v3
STRINGX_API_KEY=
STRINGX_VIDEO_MODEL=doubao-seedance-2-0-260128
STRINGX_SEEDANCE_DEFAULT_TIER=fast
STRINGX_SEEDANCE_MINI_MODEL=doubao-seedance-2-0-260128
STRINGX_SEEDANCE_FAST_MODEL=doubao-seedance-2-0-260128
STRINGX_SEEDANCE_PRO_MODEL=doubao-seedance-2-0-260128
STRINGX_REQUEST_TIMEOUT_MS=120000

VIDEO_POLL_INTERVAL_MS=5000
VIDEO_STATUS_TIMEOUT_MS=10000
VIDEO_POLL_CONCURRENCY=6
# Requeue a video whose upstream progress does not change for this long, then retry once.
VIDEO_PROCESSING_STALL_TIMEOUT_MS=360000

# Optional official Volcengine rollback route. Used only when VIDEO_PROVIDER=volc-ark.
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
ARK_REQUEST_TIMEOUT_MS=120000

# StringX MaaS Assets OpenAPI for AIGC registration and authorized portrait verification.
VOLC_ASSET_BASE_URL=https://maas-ark.stringx.top
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_ARK_PROJECT_NAME=default
ASSET_LIBRARY_CONSOLE_URL=
VOLC_ASSET_REQUEST_TIMEOUT_MS=30000

# Full preview composition.
FILM_PREVIEW_TIMEOUT_MS=600000

# Optional DeepSeek selection. When empty, STRINGX_API_KEY is reused by config.
DEEPSEEK_BASE_URL=https://maas.stringx.top
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseekV3
DEEPSEEK_CHAT_COMPLETIONS_PATH=/api/v1/chat/completions
DEEPSEEK_REQUEST_TIMEOUT_MS=180000

# DeepSeek V4 Flash/Pro use an independent OpenAI-compatible relay.
DEEPSEEK_V4_BASE_URL=https://hk.shanyoucloud.com
DEEPSEEK_V4_API_KEY=
DEEPSEEK_V4_MODEL=deepseek-v4-flash
DEEPSEEK_V4_CHAT_COMPLETIONS_PATH=/v1/chat/completions
DEEPSEEK_V4_REQUEST_TIMEOUT_MS=180000

# Preferred Alibaba Cloud Bailian DeepSeek V4 route. When DASHSCOPE_API_KEY is
# set, it takes precedence over the legacy DEEPSEEK_V4_* relay above.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=deepseek-v4-flash-0731
DASHSCOPE_CHAT_COMPLETIONS_PATH=/chat/completions
DASHSCOPE_REQUEST_TIMEOUT_MS=180000

# Rehdasu text generation. GLM/Kimi models use this OpenAI-compatible endpoint.
REHDASU_BASE_URL=https://tokenadvent.com
REHDASU_API_KEY=
REHDASU_MODEL=glm-5.2
REHDASU_CHAT_COMPLETIONS_PATH=/v1/chat/completions
REHDASU_REQUEST_TIMEOUT_MS=180000

# OpenAI-compatible GPT text selection and GPT Image 2 generation.
TOKENADVENT_BASE_URL=https://hk.shanyoucloud.com
TOKENADVENT_API_KEY=
SEQORA_IMAGE2_BASE_URL=https://hk.shanyoucloud.com
SEQORA_IMAGE2_API_KEY=
SEQORA_IMAGE2_MODEL=gpt-image-2
IMG2_MODEL=gpt-image-2
IMG2_QUALITY=low
TEXT_MODEL=deepseek-v4-flash
TOKENADVENT_REQUEST_TIMEOUT_MS=180000
