# Public domain. Point its A/AAAA record to the VM before starting Caddy.
APP_ADDRESS=studio.example.com
WEB_ORIGIN=https://studio.example.com
PUBLIC_API_BASE_URL=https://studio.example.com

TRUST_PROXY=true
RATE_LIMIT_MAX=300
AUTH_MODE=local
AUTH_SECRET=replace-with-at-least-32-random-characters

# Used only on the first start of an empty seqora_data volume.
BOOTSTRAP_CREATOR_NAME=创作者
BOOTSTRAP_CREATOR_EMAIL=creator@example.com
BOOTSTRAP_CREATOR_PASSWORD=replace-with-a-unique-creator-password
BOOTSTRAP_ADMIN_NAME=平台管理员
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
BOOTSTRAP_DEMO_WORKSPACE=false

# Runtime limits for a 2 vCPU / 4 GB closed-beta VM.
API_CPUS=1.5
API_MEMORY_LIMIT=1536m
API_NODE_HEAP_MB=768
WEB_CPUS=0.5
WEB_MEMORY_LIMIT=192m

# Google Cloud Storage. Attach a least-privilege service account to the VM.
STORAGE_DRIVER=gcs
GCS_BUCKET=replace-with-private-gcs-bucket
MAX_UPLOAD_BYTES=10485760

# StringX Seedance 2.0. Keep video and asset credentials in the same StringX tenant/project.
VIDEO_PROVIDER=stringx
STRINGX_BASE_URL=https://maas.stringx.top/api/v3
STRINGX_API_KEY=
STRINGX_VIDEO_MODEL=doubao-seedance-2-0-260128
STRINGX_REQUEST_TIMEOUT_MS=120000

VIDEO_POLL_INTERVAL_MS=5000

# Optional official Volcengine rollback route. Used only when VIDEO_PROVIDER=volc-ark.
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
ARK_REQUEST_TIMEOUT_MS=120000

# StringX MaaS Assets OpenAPI for AIGC registration and authorized portrait verification.
VOLC_ASSET_BASE_URL=https://maas-ark.stringx.top
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_ARK_PROJECT_NAME=default
ASSET_LIBRARY_CONSOLE_URL=
VOLC_ASSET_REQUEST_TIMEOUT_MS=30000

# Full preview composition.
FILM_PREVIEW_TIMEOUT_MS=600000

# TokenAdvent text and image generation.
TOKENADVENT_BASE_URL=https://tokenadvent.com
TOKENADVENT_API_KEY=
IMG2_MODEL=gpt-image-2
IMG2_QUALITY=low
TEXT_MODEL=gpt-5.6
TOKENADVENT_REQUEST_TIMEOUT_MS=180000
