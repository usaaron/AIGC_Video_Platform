# Runtime-only monitoring settings for /opt/seqora/deploy/monitoring.env.
# Do not commit the real monitoring.env file.

SYNTHETIC_BASE_URL=https://studio.example.com
SYNTHETIC_EMAIL=synthetic-monitor@example.com
SYNTHETIC_PASSWORD=replace-with-unique-synthetic-monitor-password
SYNTHETIC_ALERT_WEBHOOK_URL=https://monitoring.example.com/hooks/seqora
SYNTHETIC_TIMEOUT_MS=10000

# Required by the post-deploy write-path gate in GitHub Actions.
# This must be a dedicated non-system organization used only by synthetic probes.
SYNTHETIC_ORGANIZATION_ID=tenant-synthetic-production
