{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-human-flow*/types/**/*.ts",
    ".next-human-flow*/dev/types/**/*.ts",
    ".next-full-flow-72*/types/**/*.ts",
    ".next-full-flow-72*/dev/types/**/*.ts",
    ".next-root-capacity*/types/**/*.ts",
    ".next-root-capacity*/dev/types/**/*.ts",
    ".next-full-flow-72-r53/types/**/*.ts",
    ".next-full-flow-72-r53/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
