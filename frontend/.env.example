BACKEND_API_URL=http://127.0.0.1:8000
# Optional browser-visible override. The default /api proxy avoids CORS in development.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# start-local.sh sets this automatically so long-running LLM requests bypass the
# development rewrite proxy. Direct browser access requires backend CORS.

# Retained capability switch. The local launcher forwards the backend value.
NEXT_PUBLIC_CREATIVE_DEEPENING_ENABLED=false
