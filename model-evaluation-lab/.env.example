# 模型能力评测台。复制为 .env.local 后填写；API Key 不会发送到浏览器。
EVALUATION_HOST=127.0.0.1
EVALUATION_PORT=8090

# 每个阶段支持 MODEL_01 到 MODEL_20。所有字段均按当前产品模型配置格式命名。
# 同一阶段启用多个编号后，一次测试会把完全相同的输入分别发给每个模型。

# 1. 总纲模型
EVAL_OUTLINE_MODEL_01_LABEL='总纲模型 A'
EVAL_OUTLINE_MODEL_01_PROVIDER=openai_compatible
EVAL_OUTLINE_MODEL_01_MODEL=your-outline-model
EVAL_OUTLINE_MODEL_01_API_KEY=
EVAL_OUTLINE_MODEL_01_BASE_URL=https://your-provider.example/v1
EVAL_OUTLINE_MODEL_01_WIRE_API=chat_completions
EVAL_OUTLINE_MODEL_01_REASONING_EFFORT=high
EVAL_OUTLINE_MODEL_01_THINKING_MODE=enabled
EVAL_OUTLINE_MODEL_01_TIMEOUT_SECONDS=600
EVAL_OUTLINE_MODEL_01_MAX_RETRIES=0
EVAL_OUTLINE_MODEL_01_MAX_TOKENS=12000
EVAL_OUTLINE_MODEL_01_TEMPERATURE=0.7

