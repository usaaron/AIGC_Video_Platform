LLM_OVERSEAS_STORY_BIBLE_MAX_RETRIES=0
LLM_OVERSEAS_STORY_BIBLE_USE_STRICT_SCHEMA=true
LLM_OVERSEAS_STORY_BIBLE_SEND_RESPONSE_FORMAT=true

