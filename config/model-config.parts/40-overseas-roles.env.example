LLM_OVERSEAS_SCRIPT_CONVERSATION_EDITOR_PROVIDER="$CFG_GEMINI_PROVIDER"
LLM_OVERSEAS_SCRIPT_CONVERSATION_EDITOR_MODEL="$CFG_GEMINI_MODEL"
LLM_OVERSEAS_SCRIPT_CONVERSATION_EDITOR_BASE_URL="$CFG_GEMINI_BASE_URL"
LLM_OVERSEAS_SCRIPT_CONVERSATION_EDITOR_API_KEY="$CFG_GEMINI_API_KEY"
LLM_OVERSEAS_SCRIPT_CONVERSATION_EDITOR_WIRE_API="$CFG_GEMINI_WIRE_API"
LLM_OVERSEAS_SCRIPT_CONVERSATION_EDITOR_REASONING_EFFORT=medium
