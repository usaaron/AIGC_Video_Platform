LLM_OVERSEAS_EPISODE_PLAN_FALLBACK_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_OVERSEAS_EPISODE_PLAN_FALLBACK_REASONING_EFFORT=low
LLM_OVERSEAS_EPISODE_PLAN_FALLBACK_THINKING_MODE=disabled
LLM_OVERSEAS_EPISODE_PLAN_TIMEOUT_SECONDS=300
LLM_OVERSEAS_EPISODE_PLAN_MAX_RETRIES=0
LLM_OVERSEAS_EPISODE_PLAN_USE_STRICT_SCHEMA=true
