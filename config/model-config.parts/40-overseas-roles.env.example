LLM_OVERSEAS_INSPIRATION_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_OVERSEAS_INSPIRATION_FALLBACK_PROFILE=LLM_ASTRA
LLM_OVERSEAS_INSPIRATION_REASONING_EFFORT=medium
LLM_OVERSEAS_INSPIRATION_TIMEOUT_SECONDS=60
LLM_OVERSEAS_INSPIRATION_REQUEST_DEADLINE_SECONDS=45
LLM_OVERSEAS_INSPIRATION_MAX_RETRIES=0

# Full Story Bible: Pro with hidden reasoning disabled, 600s through Astra failover.
LLM_OVERSEAS_STORY_BIBLE_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
