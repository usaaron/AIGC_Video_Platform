# Astra: 海外创意与故事圣经；Gemini: 海外正文
LLM_OVERSEAS_CREATIVE_PROVIDER="$CFG_GPT_PROVIDER"
LLM_OVERSEAS_CREATIVE_MODEL="$CFG_GPT_MODEL"
LLM_OVERSEAS_CREATIVE_BASE_URL="$CFG_GPT_BASE_URL"
LLM_OVERSEAS_CREATIVE_API_KEY="$CFG_GPT_API_KEY"
LLM_OVERSEAS_CREATIVE_WIRE_API="$CFG_GPT_WIRE_API"
LLM_OVERSEAS_CREATIVE_REASONING_EFFORT=max
LLM_OVERSEAS_CREATIVE_TIMEOUT_SECONDS=300
LLM_OVERSEAS_CREATIVE_MAX_RETRIES=0
LLM_OVERSEAS_CREATIVE_USE_STRICT_SCHEMA=true
LLM_OVERSEAS_CREATIVE_SEND_RESPONSE_FORMAT=true

# Grill Me uses Astra as the primary interactive planning model.
LLM_OVERSEAS_INSPIRATION_PROVIDER="$CFG_GPT_PROVIDER"
LLM_OVERSEAS_INSPIRATION_MODEL="$CFG_GPT_MODEL"
LLM_OVERSEAS_INSPIRATION_BASE_URL="$CFG_GPT_BASE_URL"
LLM_OVERSEAS_INSPIRATION_API_KEY="$CFG_GPT_API_KEY"
LLM_OVERSEAS_INSPIRATION_WIRE_API="$CFG_GPT_WIRE_API"
LLM_OVERSEAS_INSPIRATION_REASONING_EFFORT=medium
LLM_OVERSEAS_INSPIRATION_TIMEOUT_SECONDS=60
LLM_OVERSEAS_INSPIRATION_MAX_RETRIES=0
LLM_OVERSEAS_INSPIRATION_REQUEST_DEADLINE_SECONDS=45

LLM_OVERSEAS_STORY_BIBLE_PROVIDER="$CFG_GPT_PROVIDER"
LLM_OVERSEAS_STORY_BIBLE_MODEL="$CFG_GPT_MODEL"
LLM_OVERSEAS_STORY_BIBLE_BASE_URL="$CFG_GPT_BASE_URL"
LLM_OVERSEAS_STORY_BIBLE_API_KEY="$CFG_GPT_API_KEY"
LLM_OVERSEAS_STORY_BIBLE_WIRE_API="$CFG_GPT_WIRE_API"
LLM_OVERSEAS_STORY_BIBLE_REASONING_EFFORT=max
LLM_OVERSEAS_STORY_BIBLE_TIMEOUT_SECONDS=300
LLM_OVERSEAS_STORY_BIBLE_MAX_RETRIES=0
LLM_OVERSEAS_STORY_BIBLE_USE_STRICT_SCHEMA=true
LLM_OVERSEAS_STORY_BIBLE_SEND_RESPONSE_FORMAT=true

# Astra: 海外剧情树与分集路线图
LLM_OVERSEAS_STORY_ARCHITECT_PROVIDER="$CFG_GPT_PROVIDER"
LLM_OVERSEAS_STORY_ARCHITECT_MODEL="$CFG_GPT_MODEL"
LLM_OVERSEAS_STORY_ARCHITECT_BASE_URL="$CFG_GPT_BASE_URL"
LLM_OVERSEAS_STORY_ARCHITECT_API_KEY="$CFG_GPT_API_KEY"
LLM_OVERSEAS_STORY_ARCHITECT_WIRE_API="$CFG_GPT_WIRE_API"
LLM_OVERSEAS_STORY_ARCHITECT_REASONING_EFFORT=max
LLM_OVERSEAS_STORY_ARCHITECT_THINKING_MODE=enabled
LLM_OVERSEAS_STORY_ARCHITECT_TIMEOUT_SECONDS=300
LLM_OVERSEAS_STORY_ARCHITECT_MAX_RETRIES=0
LLM_OVERSEAS_STORY_ARCHITECT_USE_STRICT_SCHEMA=true
LLM_OVERSEAS_STORY_ARCHITECT_SEND_RESPONSE_FORMAT=true

LLM_OVERSEAS_EPISODE_PLAN_PROVIDER="$CFG_GPT_PROVIDER"
LLM_OVERSEAS_EPISODE_PLAN_MODEL="$CFG_GPT_MODEL"
LLM_OVERSEAS_EPISODE_PLAN_BASE_URL="$CFG_GPT_BASE_URL"
LLM_OVERSEAS_EPISODE_PLAN_API_KEY="$CFG_GPT_API_KEY"
LLM_OVERSEAS_EPISODE_PLAN_WIRE_API="$CFG_GPT_WIRE_API"
LLM_OVERSEAS_EPISODE_PLAN_REASONING_EFFORT=low
LLM_OVERSEAS_EPISODE_PLAN_THINKING_MODE=disabled
LLM_OVERSEAS_EPISODE_PLAN_FALLBACK_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_OVERSEAS_EPISODE_PLAN_FALLBACK_MODEL="$CFG_DEEPSEEK_MODEL"
