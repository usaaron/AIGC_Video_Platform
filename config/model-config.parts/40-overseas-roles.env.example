LLM_OVERSEAS_SCRIPT_CONVERSATION_EDITOR_TIMEOUT_SECONDS=600
LLM_OVERSEAS_SCRIPT_CONVERSATION_EDITOR_MAX_RETRIES=1

# 独立对白呈现/翻译角色
LLM_OVERSEAS_DIALOGUE_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_OVERSEAS_DIALOGUE_MODEL="$CFG_DEEPSEEK_FLASH_MODEL"
