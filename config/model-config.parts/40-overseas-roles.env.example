LLM_OVERSEAS_SCRIPT_PROVIDER="$CFG_GEMINI_PROVIDER"
LLM_OVERSEAS_SCRIPT_MODEL="$CFG_GEMINI_MODEL"
LLM_OVERSEAS_SCRIPT_BASE_URL="$CFG_GEMINI_BASE_URL"
