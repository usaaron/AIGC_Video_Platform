# DeepSeek V4 Pro primary roles; only former Astra roles select its backup.

# OVERSEAS CREATIVE
LLM_OVERSEAS_CREATIVE_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_OVERSEAS_CREATIVE_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_OVERSEAS_CREATIVE_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_OVERSEAS_CREATIVE_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_OVERSEAS_CREATIVE_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_OVERSEAS_CREATIVE_FALLBACK_PROFILE=LLM_ASTRA
LLM_OVERSEAS_CREATIVE_REASONING_EFFORT=high
LLM_OVERSEAS_CREATIVE_TIMEOUT_SECONDS=300
LLM_OVERSEAS_CREATIVE_MAX_RETRIES=0
LLM_OVERSEAS_CREATIVE_USE_STRICT_SCHEMA=true
LLM_OVERSEAS_CREATIVE_SEND_RESPONSE_FORMAT=true

# OVERSEAS INSPIRATION
LLM_OVERSEAS_INSPIRATION_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_OVERSEAS_INSPIRATION_MODEL="$CFG_DEEPSEEK_MODEL"
