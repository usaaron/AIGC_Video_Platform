# DeepSeek V4.1 Flash primary roles; only former Astra roles select its backup.

# CN CREATIVE
LLM_CN_CREATIVE_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_CN_CREATIVE_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_CN_CREATIVE_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_CN_CREATIVE_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_CN_CREATIVE_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_CN_CREATIVE_FALLBACK_PROFILE=LLM_ASTRA
LLM_CN_CREATIVE_REASONING_EFFORT=high
LLM_CN_CREATIVE_THINKING_MODE=enabled
LLM_CN_CREATIVE_TIMEOUT_SECONDS=300
LLM_CN_CREATIVE_MAX_RETRIES=0
LLM_CN_CREATIVE_USE_STRICT_SCHEMA=true
LLM_CN_CREATIVE_SEND_RESPONSE_FORMAT=true

