LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=0
LLM_PROVIDER="$CFG_GPT_PROVIDER"
LLM_MODEL="$CFG_GPT_MODEL"
LLM_BASE_URL="$CFG_GPT_BASE_URL"
LLM_API_KEY="$CFG_GPT_API_KEY"
LLM_WIRE_API="$CFG_GPT_WIRE_API"
LLM_REASONING_EFFORT=high
LLM_PLANNING_MODEL="$CFG_GPT_MODEL"
LLM_PLANNING_BASE_URL="$CFG_GPT_BASE_URL"
LLM_PLANNING_API_KEY="$CFG_GPT_API_KEY"
LLM_PLANNING_WIRE_API="$CFG_GPT_WIRE_API"
LLM_PLANNING_REASONING_EFFORT=high
LLM_PLANNING_TIMEOUT_SECONDS=600
LLM_PLANNING_MAX_RETRIES=0
LLM_EPISODE_PLAN_CHUNK_SIZE=1

# Astra failover: one recoverable failure, 120s planning deadline, 10m cool down.
LLM_ASTRA_FALLBACK_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_ASTRA_FALLBACK_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_ASTRA_FALLBACK_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_ASTRA_FALLBACK_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_ASTRA_FALLBACK_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_ASTRA_FALLBACK_REASONING_EFFORT=high
LLM_ASTRA_FALLBACK_THINKING_MODE=enabled
LLM_ASTRA_FALLBACK_SEND_RESPONSE_FORMAT=true
LLM_ASTRA_FALLBACK_TIMEOUT_SECONDS=300
LLM_ASTRA_FALLBACK_MAX_RETRIES=0
LLM_ASTRA_FALLBACK_FAILOVER_FAILURE_THRESHOLD=1
LLM_ASTRA_FAILOVER_COOLDOWN_SECONDS=600
LLM_REQUEST_DEADLINE_SECONDS=120
LLM_PLANNING_REQUEST_DEADLINE_SECONDS=120

# Shared DeepSeek editor for all non-screenplay planning modifications.
LLM_PLANNING_EDITOR_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_PLANNING_EDITOR_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_PLANNING_EDITOR_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_PLANNING_EDITOR_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_PLANNING_EDITOR_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_PLANNING_EDITOR_REASONING_EFFORT=high
LLM_PLANNING_EDITOR_THINKING_MODE=enabled
LLM_PLANNING_EDITOR_TIMEOUT_SECONDS=300
LLM_PLANNING_EDITOR_MAX_RETRIES=0

# Input classification and extraction of supplied facts.
LLM_INPUT_READINESS_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_INPUT_READINESS_MODEL="$CFG_DEEPSEEK_FLASH_MODEL"
LLM_INPUT_READINESS_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_INPUT_READINESS_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_INPUT_READINESS_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_INPUT_READINESS_REASONING_EFFORT=none
LLM_INPUT_READINESS_THINKING_MODE=disabled
LLM_INPUT_READINESS_TIMEOUT_SECONDS=60
LLM_INPUT_READINESS_MAX_RETRIES=0
LLM_INPUT_READINESS_USE_STRICT_SCHEMA=false
LLM_INPUT_READINESS_SEND_RESPONSE_FORMAT=true
