# All active primary roles use DeepSeek V4 Pro.
# Only roles formerly using Astra opt into FALLBACK_PROFILE=LLM_ASTRA.

# Generic primary. Selectors are explicit per role and are not inherited.
LLM_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_FALLBACK_PROFILE=LLM_ASTRA
LLM_REASONING_EFFORT=high
LLM_TIMEOUT_SECONDS=300
LLM_REQUEST_DEADLINE_SECONDS=120
LLM_MAX_RETRIES=0

# Independent terminal Astra fallback for former Astra roles only.
# Leave REQUEST_DEADLINE_SECONDS unset: full Bible inherits its 600s budget;
# Inspiration keeps its short interactive deadline. No fallback selector here.
LLM_ASTRA_PROVIDER="$CFG_GPT_PROVIDER"
LLM_ASTRA_MODEL="$CFG_GPT_MODEL"
LLM_ASTRA_BASE_URL="$CFG_GPT_BASE_URL"
LLM_ASTRA_API_KEY="$CFG_GPT_API_KEY"
LLM_ASTRA_WIRE_API="$CFG_GPT_WIRE_API"
LLM_ASTRA_REASONING_EFFORT=max
LLM_ASTRA_THINKING_MODE=enabled
LLM_ASTRA_TIMEOUT_SECONDS=600
LLM_ASTRA_MAX_RETRIES=0
LLM_ASTRA_USE_STRICT_SCHEMA=true
LLM_ASTRA_SEND_RESPONSE_FORMAT=true
LLM_ASTRA_FAILOVER_COOLDOWN_SECONDS=600
LLM_ASTRA_FAILOVER_FAILURE_THRESHOLD=1

# Outline primary and the preserved Astra backup.
LLM_OUTLINE_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_OUTLINE_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_OUTLINE_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_OUTLINE_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_OUTLINE_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_OUTLINE_FALLBACK_PROFILE=LLM_ASTRA
LLM_OUTLINE_REQUEST_DEADLINE_SECONDS=120

# PLANNING
LLM_PLANNING_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_PLANNING_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_PLANNING_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_PLANNING_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_PLANNING_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_PLANNING_FALLBACK_PROFILE=LLM_ASTRA
LLM_PLANNING_REASONING_EFFORT=high
LLM_PLANNING_TIMEOUT_SECONDS=600
LLM_PLANNING_REQUEST_DEADLINE_SECONDS=120
LLM_PLANNING_MAX_RETRIES=0

# CREATIVE
LLM_CREATIVE_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_CREATIVE_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_CREATIVE_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_CREATIVE_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_CREATIVE_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_CREATIVE_FALLBACK_PROFILE=LLM_ASTRA

# Full Story Bible synthesis: no hidden reasoning; 600s on either model route.
LLM_STORY_BIBLE_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_STORY_BIBLE_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_STORY_BIBLE_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_STORY_BIBLE_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_STORY_BIBLE_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_STORY_BIBLE_FALLBACK_PROFILE=LLM_ASTRA
LLM_STORY_BIBLE_REASONING_EFFORT=medium
LLM_STORY_BIBLE_THINKING_MODE=disabled
LLM_STORY_BIBLE_TIMEOUT_SECONDS=600
LLM_STORY_BIBLE_REQUEST_DEADLINE_SECONDS=600
LLM_STORY_BIBLE_MAX_RETRIES=0

# STORY ARCHITECT
LLM_STORY_ARCHITECT_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_STORY_ARCHITECT_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_STORY_ARCHITECT_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_STORY_ARCHITECT_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_STORY_ARCHITECT_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_STORY_ARCHITECT_FALLBACK_PROFILE=LLM_ASTRA

# STORY ARCHITECT RECOVERY
LLM_STORY_ARCHITECT_RECOVERY_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_STORY_ARCHITECT_RECOVERY_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_STORY_ARCHITECT_RECOVERY_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_STORY_ARCHITECT_RECOVERY_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_STORY_ARCHITECT_RECOVERY_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_STORY_ARCHITECT_RECOVERY_FALLBACK_PROFILE=LLM_ASTRA

# EPISODE PLAN
LLM_EPISODE_PLAN_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_EPISODE_PLAN_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_EPISODE_PLAN_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_EPISODE_PLAN_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_EPISODE_PLAN_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_EPISODE_PLAN_FALLBACK_PROFILE=LLM_ASTRA
LLM_EPISODE_PLAN_CHUNK_SIZE=1

# CONTINUITY
LLM_CONTINUITY_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_CONTINUITY_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_CONTINUITY_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_CONTINUITY_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_CONTINUITY_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_CONTINUITY_FALLBACK_PROFILE=LLM_ASTRA

# SCRIPT
LLM_SCRIPT_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_SCRIPT_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_SCRIPT_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_SCRIPT_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_SCRIPT_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_SCRIPT_FALLBACK_PROFILE=LLM_ASTRA
LLM_SCRIPT_REASONING_EFFORT=high
LLM_SCRIPT_THINKING_MODE=enabled
LLM_SCRIPT_TIMEOUT_SECONDS=600
LLM_SCRIPT_MAX_RETRIES=1
LLM_SCRIPT_RETRY_EMPTY_RESPONSE=true
LLM_SCRIPT_CIRCUIT_COOLDOWN_SECONDS=600
LLM_SCRIPT_CIRCUIT_FAILURE_THRESHOLD=1
LLM_SCRIPT_HEDGE_DELAY_SECONDS=35

# SCRIPT REPAIR
LLM_SCRIPT_REPAIR_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_SCRIPT_REPAIR_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_SCRIPT_REPAIR_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_SCRIPT_REPAIR_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_SCRIPT_REPAIR_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_SCRIPT_REPAIR_FALLBACK_PROFILE=LLM_ASTRA

# SCRIPT EDITOR
LLM_SCRIPT_EDITOR_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_SCRIPT_EDITOR_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_SCRIPT_EDITOR_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_SCRIPT_EDITOR_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_SCRIPT_EDITOR_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_SCRIPT_EDITOR_FALLBACK_PROFILE=LLM_ASTRA

# DIALOGUE
LLM_DIALOGUE_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_DIALOGUE_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_DIALOGUE_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_DIALOGUE_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_DIALOGUE_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_DIALOGUE_FALLBACK_PROFILE=LLM_ASTRA

# Shared Pro editor for non-screenplay planning modifications.
LLM_PLANNING_EDITOR_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_PLANNING_EDITOR_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_PLANNING_EDITOR_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_PLANNING_EDITOR_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_PLANNING_EDITOR_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_PLANNING_EDITOR_REASONING_EFFORT=high
LLM_PLANNING_EDITOR_THINKING_MODE=enabled
LLM_PLANNING_EDITOR_TIMEOUT_SECONDS=300
LLM_PLANNING_EDITOR_MAX_RETRIES=0

# Full-scene storyboard generation keeps an independent 600s budget.
LLM_STORYBOARD_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_STORYBOARD_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_STORYBOARD_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_STORYBOARD_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_STORYBOARD_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_STORYBOARD_TIMEOUT_SECONDS=600
LLM_STORYBOARD_REQUEST_DEADLINE_SECONDS=600
LLM_STORYBOARD_MAX_RETRIES=0

# Fact extraction stays non-thinking Pro, with no added Astra backup.
LLM_INPUT_READINESS_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_INPUT_READINESS_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_INPUT_READINESS_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_INPUT_READINESS_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_INPUT_READINESS_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_INPUT_READINESS_REASONING_EFFORT=none
LLM_INPUT_READINESS_THINKING_MODE=disabled
LLM_INPUT_READINESS_TIMEOUT_SECONDS=60
LLM_INPUT_READINESS_MAX_RETRIES=0
LLM_INPUT_READINESS_USE_STRICT_SCHEMA=false
LLM_INPUT_READINESS_SEND_RESPONSE_FORMAT=true

# DEEPSEEK
LLM_DEEPSEEK_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_DEEPSEEK_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_DEEPSEEK_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_DEEPSEEK_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_DEEPSEEK_WIRE_API="$CFG_DEEPSEEK_WIRE_API"

# Legacy namespace retained for compatibility; its model is now Pro.
LLM_DEEPSEEK_FLASH_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_DEEPSEEK_FLASH_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_DEEPSEEK_FLASH_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_DEEPSEEK_FLASH_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_DEEPSEEK_FLASH_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
