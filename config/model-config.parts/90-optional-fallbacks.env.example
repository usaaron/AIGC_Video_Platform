# LLM_SCRIPT_ALTERNATE_API_KEY=FILL_DEEPSEEK_ALTERNATE_API_KEY
# LLM_SCRIPT_ALTERNATE_WIRE_API=chat_completions
# LLM_SCRIPT_ALTERNATE_MAX_RETRIES=0
