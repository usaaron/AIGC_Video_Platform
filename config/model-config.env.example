LLM_INPUT_READINESS_TIMEOUT_SECONDS=60
LLM_INPUT_READINESS_MAX_RETRIES=0
LLM_INPUT_READINESS_USE_STRICT_SCHEMA=false
LLM_INPUT_READINESS_SEND_RESPONSE_FORMAT=true

# DEEPSEEK
LLM_DEEPSEEK_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_DEEPSEEK_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_DEEPSEEK_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_DEEPSEEK_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_DEEPSEEK_WIRE_API="$CFG_DEEPSEEK_WIRE_API"

# Legacy namespace retained for compatibility; its model is now Pro.
LLM_DEEPSEEK_FLASH_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_DEEPSEEK_FLASH_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_DEEPSEEK_FLASH_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_DEEPSEEK_FLASH_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_DEEPSEEK_FLASH_WIRE_API="$CFG_DEEPSEEK_WIRE_API"

