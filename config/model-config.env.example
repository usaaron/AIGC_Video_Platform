LLM_CN_SCRIPT_CONVERSATION_EDITOR_MAX_RETRIES=1

# 独立对白呈现/翻译角色；未配置时运行时回退到通用 LLM_DIALOGUE。
LLM_CN_DIALOGUE_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
