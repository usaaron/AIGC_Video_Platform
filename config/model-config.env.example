# -----------------------------------------------------------------------------
# 90-optional-fallbacks.env: fill only when a second provider is ready
# -----------------------------------------------------------------------------
# LLM_CN_EPISODE_PLAN_ALTERNATE_01_PROVIDER=openai_compatible
# LLM_CN_EPISODE_PLAN_ALTERNATE_01_MODEL=your-qwen-fallback-model
# LLM_CN_EPISODE_PLAN_ALTERNATE_01_BASE_URL=https://your-qwen-fallback.example/v1
# LLM_CN_EPISODE_PLAN_ALTERNATE_01_API_KEY=FILL_QWEN_FALLBACK_API_KEY
# LLM_CN_EPISODE_PLAN_ALTERNATE_01_WIRE_API=chat_completions
# LLM_CN_EPISODE_PLAN_ALTERNATE_01_MAX_RETRIES=0

# Input classification and extraction of supplied facts.
LLM_INPUT_READINESS_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_INPUT_READINESS_MODEL="$CFG_DEEPSEEK_FLASH_MODEL"
LLM_INPUT_READINESS_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
