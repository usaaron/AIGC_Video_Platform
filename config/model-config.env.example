LLM_PLANNING_EDITOR_TIMEOUT_SECONDS=300
LLM_PLANNING_EDITOR_MAX_RETRIES=0

# Full-scene storyboard generation keeps an independent 600s budget.
LLM_STORYBOARD_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_STORYBOARD_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_STORYBOARD_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
