# My Comic model configuration split template
#
# Merge these sections into .env.local. The numbered parts are organizational
# templates and are not loaded automatically. Keep real keys in ignored files. Each role
# still exports the variable names consumed by backend/app/llm_runtime.py.
# The values below are placeholders; do not use them for real generation.

# -----------------------------------------------------------------------------
# 00-runtime.env: persistence and product switches
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./.cache/local-runtime/my-comic.db
SCRIPT_MARKET_PROFILE=cn_mainland
SCRIPT_CREATIVE_DEEPENING_ENABLED=false
# One-pass screenplay generation is the default. Enable the optional
# quality-gated GPT editorial pass only for projects that explicitly need it.
SCRIPT_GPT_POST_EDIT_ENABLED=false

# -----------------------------------------------------------------------------
# 10-provider-credentials.env: one URL and key slot per provider
# -----------------------------------------------------------------------------
# GPT-compatible gateway
CFG_GPT_PROVIDER=openai_compatible
CFG_GPT_MODEL=gpt-6-astra
CFG_GPT_BASE_URL=https://your-gpt-provider.example/v1
CFG_GPT_API_KEY=FILL_GPT_API_KEY
CFG_GPT_WIRE_API=responses

# Gemini-compatible gateway
CFG_GEMINI_PROVIDER=openai_compatible
CFG_GEMINI_MODEL=gemini-3.6-flash
CFG_GEMINI_BASE_URL=https://your-gemini-provider.example/v1
CFG_GEMINI_API_KEY=FILL_GEMINI_API_KEY
CFG_GEMINI_WIRE_API=chat_completions

# Qwen-compatible gateway
# Replace the dead/old gateway with the provider's current documented URL.
CFG_QWEN_PROVIDER=openai_compatible
CFG_QWEN_MODEL=qwen3.8-max
CFG_QWEN_BASE_URL=https://your-qwen-provider.example/v1
CFG_QWEN_API_KEY=FILL_QWEN_API_KEY
CFG_QWEN_WIRE_API=chat_completions

# DeepSeek-compatible gateway
CFG_DEEPSEEK_PROVIDER=openai_compatible
CFG_DEEPSEEK_MODEL=deepseek-v4-pro
CFG_DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
CFG_DEEPSEEK_BASE_URL=https://your-deepseek-provider.example/v1
CFG_DEEPSEEK_API_KEY=FILL_DEEPSEEK_API_KEY
CFG_DEEPSEEK_WIRE_API=chat_completions

# -----------------------------------------------------------------------------
# 20-common-policies.env: shared defaults and bounded retry behavior
# -----------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=0
LLM_SCRIPT_TIMEOUT_SECONDS=600
LLM_SCRIPT_MAX_RETRIES=1
LLM_SCRIPT_REASONING_EFFORT=high
LLM_SCRIPT_THINKING_MODE=enabled
LLM_SCRIPT_RETRY_EMPTY_RESPONSE=true
LLM_SCRIPT_HEDGE_DELAY_SECONDS=35
LLM_SCRIPT_CIRCUIT_FAILURE_THRESHOLD=1
LLM_SCRIPT_CIRCUIT_COOLDOWN_SECONDS=600

# Legacy generic route remains the default for code paths without a market.
LLM_PROVIDER="$CFG_GPT_PROVIDER"
LLM_MODEL="$CFG_GPT_MODEL"
LLM_BASE_URL="$CFG_GPT_BASE_URL"
LLM_API_KEY="$CFG_GPT_API_KEY"
LLM_WIRE_API="$CFG_GPT_WIRE_API"
LLM_REASONING_EFFORT=high
LLM_PLANNING_MODEL="$CFG_GPT_MODEL"
LLM_PLANNING_BASE_URL="$CFG_GPT_BASE_URL"
LLM_PLANNING_API_KEY="$CFG_GPT_API_KEY"
LLM_PLANNING_WIRE_API="$CFG_GPT_WIRE_API"
LLM_PLANNING_REASONING_EFFORT=high
LLM_PLANNING_TIMEOUT_SECONDS=600
LLM_PLANNING_MAX_RETRIES=0
LLM_EPISODE_PLAN_CHUNK_SIZE=1

# Shared Astra fallback and request budgets, including retries and streaming.
LLM_ASTRA_FALLBACK_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_ASTRA_FALLBACK_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_ASTRA_FALLBACK_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_ASTRA_FALLBACK_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_ASTRA_FALLBACK_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_ASTRA_FALLBACK_REASONING_EFFORT=high
LLM_ASTRA_FALLBACK_THINKING_MODE=enabled
LLM_ASTRA_FALLBACK_SEND_RESPONSE_FORMAT=true
LLM_ASTRA_FALLBACK_TIMEOUT_SECONDS=300
LLM_ASTRA_FALLBACK_MAX_RETRIES=0
LLM_ASTRA_FALLBACK_FAILOVER_FAILURE_THRESHOLD=1
LLM_ASTRA_FAILOVER_COOLDOWN_SECONDS=600
LLM_REQUEST_DEADLINE_SECONDS=120
LLM_PLANNING_REQUEST_DEADLINE_SECONDS=120

# Shared across both markets; separate from initial planning generation.
LLM_PLANNING_EDITOR_PROVIDER="$CFG_DEEPSEEK_PROVIDER"
LLM_PLANNING_EDITOR_MODEL="$CFG_DEEPSEEK_MODEL"
LLM_PLANNING_EDITOR_BASE_URL="$CFG_DEEPSEEK_BASE_URL"
LLM_PLANNING_EDITOR_API_KEY="$CFG_DEEPSEEK_API_KEY"
LLM_PLANNING_EDITOR_WIRE_API="$CFG_DEEPSEEK_WIRE_API"
LLM_PLANNING_EDITOR_REASONING_EFFORT=high
LLM_PLANNING_EDITOR_THINKING_MODE=enabled
LLM_PLANNING_EDITOR_TIMEOUT_SECONDS=300
LLM_PLANNING_EDITOR_MAX_RETRIES=0

# -----------------------------------------------------------------------------
