# Optional market-specific same-model screenplay failover gateways. Uncomment
# the block for the market/role that needs another host. MODEL must exactly
# match the corresponding primary market route; API_KEY and BASE_URL are
# required and are never inherited from another market. Repeat SCRIPT as
# SCRIPT_REPAIR or SCRIPT_EDITOR for the repair/editor roles.
# LLM_OVERSEAS_SCRIPT_ALTERNATE_PROVIDER=openai_compatible
