LLM_CN_SCRIPT_REPAIR_PROVIDER=openai_compatible
LLM_CN_SCRIPT_REPAIR_MODEL=deepseek-v4-1-flash-260910
LLM_CN_SCRIPT_REPAIR_API_KEY=
