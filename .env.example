# Dialogue presentation/translation is a separate role from screenplay editing.
# It is used by the bilingual presentation endpoint; when omitted it falls back
# to the generic LLM_DIALOGUE / LLM_SCRIPT_EDITOR profile.
LLM_CN_DIALOGUE_PROVIDER=openai_compatible
LLM_CN_DIALOGUE_MODEL=deepseek-v4-1-flash-260910
LLM_CN_DIALOGUE_API_KEY=
LLM_CN_DIALOGUE_BASE_URL=https://your-deepseek-provider.example/v1
LLM_CN_DIALOGUE_WIRE_API=chat_completions
LLM_CN_DIALOGUE_REASONING_EFFORT=none
LLM_CN_DIALOGUE_THINKING_MODE=disabled
LLM_CN_DIALOGUE_TIMEOUT_SECONDS=120
LLM_CN_DIALOGUE_MAX_RETRIES=0
LLM_CN_DIALOGUE_USE_STRICT_SCHEMA=false
LLM_CN_DIALOGUE_SEND_RESPONSE_FORMAT=true

LLM_OVERSEAS_CREATIVE_PROVIDER=openai_compatible
LLM_OVERSEAS_CREATIVE_MODEL=deepseek-v4-1-flash-260910
LLM_OVERSEAS_CREATIVE_API_KEY=
LLM_OVERSEAS_CREATIVE_BASE_URL=https://your-deepseek-provider.example/v1
LLM_OVERSEAS_CREATIVE_WIRE_API=chat_completions
LLM_OVERSEAS_CREATIVE_REASONING_EFFORT=high
LLM_OVERSEAS_CREATIVE_TIMEOUT_SECONDS=300
LLM_OVERSEAS_CREATIVE_MAX_RETRIES=0
LLM_OVERSEAS_CREATIVE_USE_STRICT_SCHEMA=true
LLM_OVERSEAS_CREATIVE_SEND_RESPONSE_FORMAT=true

LLM_OVERSEAS_INSPIRATION_PROVIDER=openai_compatible
LLM_OVERSEAS_INSPIRATION_MODEL=deepseek-v4-1-flash-260910
LLM_OVERSEAS_INSPIRATION_API_KEY=
LLM_OVERSEAS_INSPIRATION_BASE_URL=https://your-deepseek-provider.example/v1
LLM_OVERSEAS_INSPIRATION_WIRE_API=chat_completions
LLM_OVERSEAS_INSPIRATION_REASONING_EFFORT=medium
LLM_OVERSEAS_INSPIRATION_THINKING_MODE=enabled
LLM_OVERSEAS_INSPIRATION_TIMEOUT_SECONDS=60
