LLM_CN_CONTINUITY_PROVIDER=openai_compatible
LLM_CN_CONTINUITY_MODEL=deepseek-v4-1-flash-260910
LLM_CN_CONTINUITY_API_KEY=
LLM_CN_CONTINUITY_BASE_URL=https://your-deepseek-provider.example/v1
LLM_CN_CONTINUITY_WIRE_API=chat_completions
LLM_CN_CONTINUITY_REASONING_EFFORT=high
