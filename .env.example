LLM_CN_SCRIPT_MAX_RETRIES=1
LLM_CN_SCRIPT_USE_STRICT_SCHEMA=false
LLM_CN_SCRIPT_SEND_RESPONSE_FORMAT=true
LLM_CN_SCRIPT_RETRY_EMPTY_RESPONSE=true

LLM_CN_SCRIPT_CONVERSATION_EDITOR_PROVIDER=openai_compatible
LLM_CN_SCRIPT_CONVERSATION_EDITOR_MODEL=deepseek-v4-1-flash-260910
LLM_CN_SCRIPT_CONVERSATION_EDITOR_API_KEY=
LLM_CN_SCRIPT_CONVERSATION_EDITOR_BASE_URL=https://your-deepseek-provider.example/v1
