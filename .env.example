# Copy this file to .env.local for real script generation.
# Keep .env.local private; it is ignored by Git.

LLM_PROVIDER=openai_compatible
LLM_MODEL=your-model-name
LLM_API_KEY=replace-with-your-key
LLM_BASE_URL=https://your-provider.example/v1
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2

# Production persistence for long-story planning and full frontend workspace snapshots.
# start-local.sh applies pending Alembic migrations when this value is configured.
DATABASE_URL=postgresql+psycopg://ai_comic:change-me@127.0.0.1:5432/ai_comic_content_os

# Runtime market profile. Mainland China is the current default.
# Set to overseas_tiktok only when intentionally re-enabling the retained
# overseas validation profile.
SCRIPT_MARKET_PROFILE=cn_mainland

# Retained capability switch. Keep false during the mainland long-story phase.
SCRIPT_CREATIVE_DEEPENING_ENABLED=false

# Optional local ports.
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
