# Copy this file to .env.local and replace every FILL_* value.
# A grouped provider/role reference is available at
# config/model-config.env.example; runtime values are read from .env.local.
# Never commit .env.local or real provider credentials.

# Require the host authorization callback when embedding in the host product.
HOST_INTEGRATION_REQUIRED=false
# Set the same value as the host API SCRIPT_MASTER_SHARED_SECRET when this
# service is launched from the main product. The frontend receives a short
# lived signed token and sends it as Authorization: Bearer.
# HOST_INTEGRATION_SECRET=replace-with-the-host-shared-secret

# Default generation route: DeepSeek V4.1 Flash.
LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-v4-1-flash-260910
LLM_API_KEY=replace-with-your-key
LLM_BASE_URL=https://your-provider.example/v1
LLM_WIRE_API=chat_completions
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=1

LLM_PLANNING_MODEL=deepseek-v4-1-flash-260910
LLM_PLANNING_WIRE_API=chat_completions
LLM_PLANNING_REASONING_EFFORT=high
LLM_PLANNING_TIMEOUT_SECONDS=600
LLM_PLANNING_MAX_RETRIES=1

# Recursive tree generation keeps the planning model at high reasoning. Its
# bounded repair path uses the same model with a smaller, non-thinking profile.
LLM_STORY_ARCHITECT_REASONING_EFFORT=high
LLM_STORY_ARCHITECT_TIMEOUT_SECONDS=240
LLM_STORY_ARCHITECT_MAX_RETRIES=0
LLM_STORY_ARCHITECT_RECOVERY_REASONING_EFFORT=medium
LLM_STORY_ARCHITECT_RECOVERY_THINKING_MODE=disabled
LLM_STORY_ARCHITECT_RECOVERY_TIMEOUT_SECONDS=180
LLM_STORY_ARCHITECT_RECOVERY_MAX_RETRIES=0
LLM_STORY_ARCHITECT_RECOVERY_USE_STRICT_SCHEMA=false
LLM_STORY_ARCHITECT_RECOVERY_SEND_RESPONSE_FORMAT=true
LLM_STORY_ARCHITECT_RECOVERY_RETRY_EMPTY_RESPONSE=false

# Optional recursive-planning fallback gateway. It must expose the exact same
# planning model as the primary route; script/DeepSeek routes are never reused.
# LLM_STORY_ARCHITECT_FALLBACK_PROVIDER=openai_compatible
# LLM_STORY_ARCHITECT_FALLBACK_MODEL=your-model-name
# LLM_STORY_ARCHITECT_FALLBACK_API_KEY=FILL_SECONDARY_GPT_API_KEY
# LLM_STORY_ARCHITECT_FALLBACK_BASE_URL=https://your-secondary-provider.example/v1
# LLM_STORY_ARCHITECT_FALLBACK_WIRE_API=responses
# LLM_STORY_ARCHITECT_FALLBACK_REASONING_EFFORT=high
# LLM_STORY_ARCHITECT_FALLBACK_TIMEOUT_SECONDS=240
# LLM_STORY_ARCHITECT_FALLBACK_MAX_RETRIES=0

# Story Bible keeps the planning route but uses an interactive fast profile.
LLM_STORY_BIBLE_REASONING_EFFORT=medium
LLM_STORY_BIBLE_TIMEOUT_SECONDS=600
LLM_STORY_BIBLE_MAX_RETRIES=0
LLM_STORY_BIBLE_THINKING_MODE=disabled
LLM_STORY_BIBLE_USE_STRICT_SCHEMA=false
LLM_STORY_BIBLE_SEND_RESPONSE_FORMAT=true
LLM_STORY_BIBLE_RETRY_EMPTY_RESPONSE=true

# Per-episode roadmaps use a compact profile. Keep primary and fallback waits
# independent so a stalled planning route cannot inherit a long script timeout.
LLM_EPISODE_PLAN_WIRE_API=chat_completions
LLM_EPISODE_PLAN_REASONING_EFFORT=low
LLM_EPISODE_PLAN_THINKING_MODE=disabled
LLM_EPISODE_PLAN_TIMEOUT_SECONDS=180
LLM_EPISODE_PLAN_MAX_RETRIES=0
LLM_EPISODE_PLAN_CHUNK_SIZE=3
LLM_EPISODE_PLAN_USE_STRICT_SCHEMA=false
LLM_EPISODE_PLAN_SEND_RESPONSE_FORMAT=true
LLM_EPISODE_PLAN_RETRY_EMPTY_RESPONSE=false
LLM_EPISODE_PLAN_CIRCUIT_FAILURE_THRESHOLD=1
LLM_EPISODE_PLAN_CIRCUIT_COOLDOWN_SECONDS=180

# Optional independent episode-roadmap gateways. A route is enabled only when
# its own MODEL, API_KEY, and BASE_URL are all present; primary keys are never
# inherited across domains. The order is primary -> 01 -> 02 -> legacy fallback.
# LLM_EPISODE_PLAN_ALTERNATE_01_PROVIDER=openai_compatible
# LLM_EPISODE_PLAN_ALTERNATE_01_MODEL=gpt-5.6-sol
# LLM_EPISODE_PLAN_ALTERNATE_01_API_KEY=FILL_OPENROUTER_ICU_API_KEY
# LLM_EPISODE_PLAN_ALTERNATE_01_BASE_URL=https://openrouter.icu/v1
# LLM_EPISODE_PLAN_ALTERNATE_01_WIRE_API=chat_completions
# LLM_EPISODE_PLAN_ALTERNATE_01_THINKING_MODE=disabled
# LLM_EPISODE_PLAN_ALTERNATE_01_TIMEOUT_SECONDS=45
# LLM_EPISODE_PLAN_ALTERNATE_01_MAX_RETRIES=0
# LLM_EPISODE_PLAN_ALTERNATE_01_USE_STRICT_SCHEMA=false
# LLM_EPISODE_PLAN_ALTERNATE_01_SEND_RESPONSE_FORMAT=false
# LLM_EPISODE_PLAN_ALTERNATE_01_RETRY_EMPTY_RESPONSE=false
# LLM_EPISODE_PLAN_ALTERNATE_02_PROVIDER=openai_compatible
# LLM_EPISODE_PLAN_ALTERNATE_02_MODEL=deepseek-v4-1-flash-260910
# LLM_EPISODE_PLAN_ALTERNATE_02_API_KEY=FILL_TOKENADVENT_API_KEY
# LLM_EPISODE_PLAN_ALTERNATE_02_BASE_URL=https://tokenadvent.com/v1
# LLM_EPISODE_PLAN_ALTERNATE_02_WIRE_API=chat_completions
# LLM_EPISODE_PLAN_ALTERNATE_02_THINKING_MODE=disabled
# LLM_EPISODE_PLAN_ALTERNATE_02_TIMEOUT_SECONDS=45
# LLM_EPISODE_PLAN_ALTERNATE_02_MAX_RETRIES=0
# LLM_EPISODE_PLAN_ALTERNATE_02_USE_STRICT_SCHEMA=false
# LLM_EPISODE_PLAN_ALTERNATE_02_SEND_RESPONSE_FORMAT=false
# LLM_EPISODE_PLAN_ALTERNATE_02_RETRY_EMPTY_RESPONSE=false
LLM_EPISODE_PLAN_FALLBACK_REASONING_EFFORT=medium
LLM_EPISODE_PLAN_FALLBACK_THINKING_MODE=disabled
LLM_EPISODE_PLAN_FALLBACK_TIMEOUT_SECONDS=45
LLM_EPISODE_PLAN_FALLBACK_MAX_RETRIES=0
LLM_EPISODE_PLAN_FALLBACK_USE_STRICT_SCHEMA=false
LLM_EPISODE_PLAN_FALLBACK_SEND_RESPONSE_FORMAT=false
LLM_EPISODE_PLAN_FALLBACK_RETRY_EMPTY_RESPONSE=false

# Script draft route (DeepSeek in the current product configuration).
LLM_SCRIPT_PROVIDER=openai_compatible
LLM_SCRIPT_MODEL=deepseek-v4-1-flash-260910
LLM_SCRIPT_API_KEY=FILL_DEEPSEEK_API_KEY
LLM_SCRIPT_BASE_URL=https://your-script-provider.example/v1
LLM_SCRIPT_WIRE_API=chat_completions
LLM_SCRIPT_REASONING_EFFORT=high
LLM_SCRIPT_THINKING_MODE=enabled
LLM_SCRIPT_TIMEOUT_SECONDS=600
LLM_SCRIPT_MAX_RETRIES=1
LLM_SCRIPT_RETRY_EMPTY_RESPONSE=true
LLM_SCRIPT_HEDGE_DELAY_SECONDS=35
# Keep high reasoning, but prefer ordinary JSON transport for 15 minutes as soon
# as one SSE run spends its whole output budget on hidden reasoning.
LLM_SCRIPT_ADAPTIVE_NON_STREAM_THRESHOLD=1
LLM_SCRIPT_ADAPTIVE_NON_STREAM_COOLDOWN_SECONDS=900
# Bypass a transiently failing primary gateway across the current batch instead
# of probing it again during every episode.
LLM_SCRIPT_CIRCUIT_FAILURE_THRESHOLD=1
LLM_SCRIPT_CIRCUIT_COOLDOWN_SECONDS=600

# Optional same-model screenplay gateway. It is used immediately after a
# transient/empty primary response and then temporarily bypasses that primary.
# LLM_SCRIPT_ALTERNATE_PROVIDER=openai_compatible
# LLM_SCRIPT_ALTERNATE_MODEL=deepseek-v4-1-flash-260910
# LLM_SCRIPT_ALTERNATE_API_KEY=FILL_TOKENADVENT_API_KEY
# LLM_SCRIPT_ALTERNATE_BASE_URL=https://tokenadvent.com/v1
# LLM_SCRIPT_ALTERNATE_WIRE_API=chat_completions
# LLM_SCRIPT_ALTERNATE_REASONING_EFFORT=high
# LLM_SCRIPT_ALTERNATE_THINKING_MODE=enabled
# LLM_SCRIPT_ALTERNATE_TIMEOUT_SECONDS=180
# LLM_SCRIPT_ALTERNATE_MAX_RETRIES=1
# LLM_SCRIPT_ALTERNATE_USE_STRICT_SCHEMA=false
# LLM_SCRIPT_ALTERNATE_SEND_RESPONSE_FORMAT=true
# LLM_SCRIPT_ALTERNATE_RETRY_EMPTY_RESPONSE=true

# Optional second same-model screenplay fallback via Alibaba Cloud Model Studio.
# Fill the API key and uncomment this block to enable it after the existing
# screenplay alternate route.
# Model label: DeepSeek; request model ID must match the primary screenplay model.
# LLM_SCRIPT_ALTERNATE_02_PROVIDER=openai_compatible
# LLM_SCRIPT_ALTERNATE_02_MODEL=deepseek-v4-1-flash-260910
# LLM_SCRIPT_ALTERNATE_02_API_KEY=FILL_DASHSCOPE_DEEPSEEK_API_KEY
# LLM_SCRIPT_ALTERNATE_02_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_SCRIPT_ALTERNATE_02_WIRE_API=chat_completions
# LLM_SCRIPT_ALTERNATE_02_REASONING_EFFORT=high
# LLM_SCRIPT_ALTERNATE_02_THINKING_MODE=enabled
# LLM_SCRIPT_ALTERNATE_02_TIMEOUT_SECONDS=600
# LLM_SCRIPT_ALTERNATE_02_MAX_RETRIES=1
# LLM_SCRIPT_ALTERNATE_02_USE_STRICT_SCHEMA=false
# LLM_SCRIPT_ALTERNATE_02_SEND_RESPONSE_FORMAT=false
# LLM_SCRIPT_ALTERNATE_02_RETRY_EMPTY_RESPONSE=true

# JSON/contract repair inherits the script model and its alternate route.
LLM_SCRIPT_REPAIR_REASONING_EFFORT=high
LLM_SCRIPT_REPAIR_THINKING_MODE=enabled
LLM_SCRIPT_REPAIR_MAX_RETRIES=1
LLM_SCRIPT_REPAIR_RETRY_EMPTY_RESPONSE=true

# Optional screenplay post-editor. It runs only when the local quality gate
# finds an issue; it is disabled by default for one-pass generation.
LLM_SCRIPT_EDITOR_PROVIDER=openai_compatible
LLM_SCRIPT_EDITOR_MODEL=deepseek-v4-1-flash-260910
LLM_SCRIPT_EDITOR_API_KEY=FILL_DEEPSEEK_API_KEY
LLM_SCRIPT_EDITOR_BASE_URL=https://your-editor-provider.example/v1
LLM_SCRIPT_EDITOR_WIRE_API=chat_completions
LLM_SCRIPT_EDITOR_REASONING_EFFORT=medium
LLM_SCRIPT_EDITOR_TIMEOUT_SECONDS=600
LLM_SCRIPT_EDITOR_MAX_RETRIES=1

# Local persistence defaults to .cache/local-runtime/my-comic.db when omitted.
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/ai_comic_content_os

# Default market for newly created projects. The input form can switch each
# project between cn_mainland and overseas; startup initializes both resources.
SCRIPT_MARKET_PROFILE=cn_mainland
SCRIPT_CREATIVE_DEEPENING_ENABLED=false
# One-pass screenplay generation is the default. Set true to enable the
# optional quality-gated GPT editorial pass for the complete episode body.
SCRIPT_GPT_POST_EDIT_ENABLED=false

# Astra fallback policy: one recoverable failure opens the circuit. Long
# planning calls wait up to 120s; Grill Me overrides this to 45s above.
LLM_ASTRA_FALLBACK_PROVIDER=openai_compatible
LLM_ASTRA_FALLBACK_MODEL=deepseek-v4-1-flash-260910
LLM_ASTRA_FALLBACK_API_KEY=
LLM_ASTRA_FALLBACK_BASE_URL=https://your-deepseek-provider.example/v1
LLM_ASTRA_FALLBACK_WIRE_API=chat_completions
LLM_ASTRA_FALLBACK_REASONING_EFFORT=high
LLM_ASTRA_FALLBACK_THINKING_MODE=enabled
LLM_ASTRA_FALLBACK_SEND_RESPONSE_FORMAT=true
LLM_ASTRA_FALLBACK_TIMEOUT_SECONDS=300
LLM_ASTRA_FALLBACK_MAX_RETRIES=0
LLM_ASTRA_FALLBACK_FAILOVER_FAILURE_THRESHOLD=1
LLM_ASTRA_FAILOVER_COOLDOWN_SECONDS=600
LLM_REQUEST_DEADLINE_SECONDS=600

# Market-specific model division. These routes take priority when a ContentSpec
# declares its market path; all roles keep the same JSON schema and repair flow.
# Mainland: DeepSeek Pro for planning, screenplay and conversation edits.
# Overseas: DeepSeek Pro for every primary role; former Astra roles keep Astra backup.
LLM_CN_CREATIVE_PROVIDER=openai_compatible
LLM_CN_CREATIVE_MODEL=deepseek-v4-1-flash-260910
LLM_CN_CREATIVE_API_KEY=
LLM_CN_CREATIVE_BASE_URL=https://your-deepseek-provider.example/v1
LLM_CN_CREATIVE_WIRE_API=chat_completions
LLM_CN_CREATIVE_REASONING_EFFORT=high
LLM_CN_CREATIVE_THINKING_MODE=enabled
LLM_CN_CREATIVE_TIMEOUT_SECONDS=300
LLM_CN_CREATIVE_MAX_RETRIES=0
LLM_CN_CREATIVE_USE_STRICT_SCHEMA=true
LLM_CN_CREATIVE_SEND_RESPONSE_FORMAT=true

# Inspiration chat uses the same market model with bounded medium reasoning.
# It only collects author decisions and has a 60-second interactive deadline;
# final Story Bible synthesis keeps the independent STORY_BIBLE profile below.
LLM_CN_INSPIRATION_PROVIDER=openai_compatible
LLM_CN_INSPIRATION_MODEL=deepseek-v4-1-flash-260910
LLM_CN_INSPIRATION_API_KEY=
LLM_CN_INSPIRATION_BASE_URL=https://your-deepseek-provider.example/v1
LLM_CN_INSPIRATION_WIRE_API=chat_completions
LLM_CN_INSPIRATION_REASONING_EFFORT=medium
LLM_CN_INSPIRATION_THINKING_MODE=enabled
LLM_CN_INSPIRATION_TIMEOUT_SECONDS=60
LLM_CN_INSPIRATION_MAX_RETRIES=0
LLM_CN_INSPIRATION_USE_STRICT_SCHEMA=true
LLM_CN_INSPIRATION_SEND_RESPONSE_FORMAT=true
LLM_CN_INSPIRATION_RETRY_EMPTY_RESPONSE=false
LLM_CN_INSPIRATION_REQUEST_DEADLINE_SECONDS=45

LLM_CN_STORY_BIBLE_PROVIDER=openai_compatible
LLM_CN_STORY_BIBLE_MODEL=deepseek-v4-1-flash-260910
LLM_CN_STORY_BIBLE_API_KEY=
LLM_CN_STORY_BIBLE_BASE_URL=https://your-deepseek-provider.example/v1
LLM_CN_STORY_BIBLE_WIRE_API=chat_completions
LLM_CN_STORY_BIBLE_REASONING_EFFORT=high
LLM_CN_STORY_BIBLE_THINKING_MODE=enabled
LLM_CN_STORY_BIBLE_TIMEOUT_SECONDS=600
LLM_CN_STORY_BIBLE_MAX_RETRIES=0
LLM_CN_STORY_BIBLE_USE_STRICT_SCHEMA=true
LLM_CN_STORY_BIBLE_SEND_RESPONSE_FORMAT=true
LLM_CN_STORY_BIBLE_RETRY_EMPTY_RESPONSE=true

# Legacy per-market outline editor uses DeepSeek; initial outline
# generation remains on the market-specific creative model above.
LLM_CN_STORY_BIBLE_EDITOR_PROVIDER=openai_compatible
LLM_CN_STORY_BIBLE_EDITOR_MODEL=deepseek-v4-1-flash-260910
LLM_CN_STORY_BIBLE_EDITOR_API_KEY=
LLM_CN_STORY_BIBLE_EDITOR_BASE_URL=https://your-deepseek-provider.example/v1
LLM_CN_STORY_BIBLE_EDITOR_WIRE_API=chat_completions
LLM_CN_STORY_BIBLE_EDITOR_REASONING_EFFORT=medium
LLM_CN_STORY_BIBLE_EDITOR_THINKING_MODE=disabled
LLM_CN_STORY_BIBLE_EDITOR_TIMEOUT_SECONDS=300
LLM_CN_STORY_BIBLE_EDITOR_MAX_RETRIES=0
LLM_CN_STORY_BIBLE_EDITOR_USE_STRICT_SCHEMA=false
LLM_CN_STORY_BIBLE_EDITOR_SEND_RESPONSE_FORMAT=false

LLM_CN_STORY_ARCHITECT_PROVIDER=openai_compatible
LLM_CN_STORY_ARCHITECT_MODEL=deepseek-v4-1-flash-260910
LLM_CN_STORY_ARCHITECT_API_KEY=
LLM_CN_STORY_ARCHITECT_BASE_URL=https://your-deepseek-provider.example/v1
LLM_CN_STORY_ARCHITECT_WIRE_API=chat_completions
LLM_CN_STORY_ARCHITECT_REASONING_EFFORT=high
LLM_CN_STORY_ARCHITECT_THINKING_MODE=enabled
LLM_CN_STORY_ARCHITECT_TIMEOUT_SECONDS=300
LLM_CN_STORY_ARCHITECT_MAX_RETRIES=0
LLM_CN_STORY_ARCHITECT_USE_STRICT_SCHEMA=true
LLM_CN_STORY_ARCHITECT_SEND_RESPONSE_FORMAT=true

LLM_CN_STORY_ARCHITECT_RECOVERY_PROVIDER=openai_compatible
LLM_CN_STORY_ARCHITECT_RECOVERY_MODEL=deepseek-v4-1-flash-260910
LLM_CN_STORY_ARCHITECT_RECOVERY_API_KEY=
LLM_CN_STORY_ARCHITECT_RECOVERY_BASE_URL=https://your-deepseek-provider.example/v1
LLM_CN_STORY_ARCHITECT_RECOVERY_WIRE_API=chat_completions
LLM_CN_STORY_ARCHITECT_RECOVERY_REASONING_EFFORT=high
LLM_CN_STORY_ARCHITECT_RECOVERY_THINKING_MODE=enabled
LLM_CN_STORY_ARCHITECT_RECOVERY_TIMEOUT_SECONDS=300
LLM_CN_STORY_ARCHITECT_RECOVERY_MAX_RETRIES=0
LLM_CN_STORY_ARCHITECT_RECOVERY_USE_STRICT_SCHEMA=true
LLM_CN_STORY_ARCHITECT_RECOVERY_SEND_RESPONSE_FORMAT=true

LLM_CN_EPISODE_PLAN_PROVIDER=openai_compatible
LLM_CN_EPISODE_PLAN_MODEL=deepseek-v4-1-flash-260910
LLM_CN_EPISODE_PLAN_API_KEY=
LLM_CN_EPISODE_PLAN_BASE_URL=https://your-deepseek-provider.example/v1
LLM_CN_EPISODE_PLAN_WIRE_API=chat_completions
LLM_CN_EPISODE_PLAN_REASONING_EFFORT=high
LLM_CN_EPISODE_PLAN_THINKING_MODE=enabled
LLM_CN_EPISODE_PLAN_TIMEOUT_SECONDS=300
LLM_CN_EPISODE_PLAN_MAX_RETRIES=0
LLM_CN_EPISODE_PLAN_USE_STRICT_SCHEMA=true
LLM_CN_EPISODE_PLAN_SEND_RESPONSE_FORMAT=true

LLM_CN_SCRIPT_PROVIDER=openai_compatible
LLM_CN_SCRIPT_MODEL=deepseek-v4-1-flash-260910
LLM_CN_SCRIPT_API_KEY=
LLM_CN_SCRIPT_BASE_URL=https://your-deepseek-provider.example/v1
LLM_CN_SCRIPT_WIRE_API=chat_completions
LLM_CN_SCRIPT_REASONING_EFFORT=high
LLM_CN_SCRIPT_THINKING_MODE=enabled
